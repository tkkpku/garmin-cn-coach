# 环境变量清单（示例）
# ============================================================================
# ⚠️ 本项目**不加载任何 .env 文件**（没有引入 dotenv）。本文件只是清单。
#    请在 shell 里设置：
#      PowerShell:  $env:GARMIN_CDP_PORT='9222'
#      bash/zsh:    export GARMIN_CDP_PORT=9222
# ============================================================================

# 调试端口（默认 9222，与 start-edge-debug.cmd 一致）
GARMIN_CDP_PORT=9222

# 周报 md 输出路径（默认 <repo>/scripts/reports/garmin_weekly.md；目录会自动创建）
# GARMIN_REPORT=D:\notes\garmin_weekly.md

# 自定义 Edge User Data 目录（一般不用设）
# GARMIN_USER_DATA=C:\Users\you\AppData\Local\Microsoft\Edge\User Data
